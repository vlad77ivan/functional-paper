---
import ThemeToggle from '@components/ThemeToggle.astro';
---
<label class="mobile-menu overflow-y-hidden overscroll-y-contain flex w-12 relative z-40 cursor-pointer" for="mobile-menu">
  <input class="peer hidden" type="checkbox" id="mobile-menu" />
  <div class="hamburger"></div>
  <div class="fixed inset-0 z-40 hidden h-full w-full bg-black/50 backdrop-blur-sm peer-checked:block">&nbsp;</div>
  <div id="mobile-menu-panel" class="fixed top-0 right-0 z-40 h-full w-full translate-x-full touch-none transition duration-100 peer-checked:translate-x-0">
      <div class="float-right min-h-full w-[40%] bg-custom-white dark:bg-custom-gray px-6 pt-12 shadow-2xl">
        <ul class="hamburger-links">
          <li class="menu-option"><a href="/about/" class="menu-option-link">About</a></li>
          <li class="menu-option"><a href="/blog/" class="menu-option-link">Blog</a></li>
          <li class="menu-option"><a href="/search/" class="menu-option-link">Search</a></li>
          <li class="menu-option"><a href="/tags/" class="menu-option-link">Tags</a></li>
          <li class="flex h-8"><span><ThemeToggle /></span><li>
        </ul>
      </div>
  </div>
</label>

<script>
  document.addEventListener('astro:page-load', () => {
    const menuCheckbox = document.getElementById('mobile-menu') as HTMLInputElement | null;
    const menuLinks = document.querySelectorAll<HTMLAnchorElement>('.menu-option-link');
    const panel = document.getElementById('mobile-menu-panel');
    const hamburgerBar = document.querySelector<HTMLElement>('.hamburger');

    menuLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.stopPropagation();
        // Disable transitions so the menu closes instantly, no animation mid-navigation
        if (hamburgerBar) hamburgerBar.classList.add('no-animation');
        if (panel) panel.style.transitionDuration = '0ms';
        if (menuCheckbox) menuCheckbox.checked = false;
        requestAnimationFrame(() => {
          hamburgerBar?.classList.remove('no-animation');
          if (panel) panel.style.transitionDuration = '';
        });
      });
    });
  });
</script>

<style>
  @reference "../styles/global.css";
  .hamburger {
    @apply mx-auto self-center relative z-50 block h-[2px] w-7 bg-custom-accent content-[''] before:absolute before:top-[-0.5rem] before:z-50 before:block before:h-full before:w-full before:bg-custom-accent before:transition-all before:duration-200 before:ease-out before:content-[''] after:absolute after:right-0 after:bottom-[-0.5rem] after:block after:h-full after:w-full after:bg-custom-accent after:transition-all after:duration-200 after:ease-out after:content-[''];
  }
  /* peer-checked compound variants don't work in @apply in Tailwind v4 — use plain CSS */
  .mobile-menu input:checked ~ .hamburger {
    background-color: transparent;
  }
  .mobile-menu input:checked ~ .hamburger::before {
    top: 0;
    width: 100%;
    transform: rotate(45deg);
  }
  .mobile-menu input:checked ~ .hamburger::after {
    bottom: 0;
    width: 100%;
    transform: rotate(-45deg);
  }
  .hamburger-links {
    @apply flex flex-col gap-y-4;
  }
  .menu-option {
    @apply flex h-8 text-lg border-b border-custom-accent;
  }
  .menu-option-link {
    @apply grow hover:text-custom-accent-3;
  }
  .hamburger.no-animation::before,
  .hamburger.no-animation::after {
    transition-duration: 0ms;
  }

  @media screen and (min-width: 720px) {  
    .mobile-menu {
      @apply hidden;
    }
  }
</style>