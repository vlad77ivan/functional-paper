---
import type { Post } from "@content/config.ts";
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import Author from "@components/Author.astro";
import Comments from "@components/Comments.astro"
import TagCard from "@components/TagCard.astro";
import { formatDate } from "@utils/date.ts";
import { getImageWidths, getImageSizes } from "@utils/image.ts";

interface Props {
  frontmatter: Post;
}

const { frontmatter } = Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <ul class="post-tags">
    {frontmatter.tags.map((tag: string) => (
      <li><TagCard tag={tag} /></li>
    ))}
  </ul>

  <article data-pagefind-body>
    <h1 class="post-title">{frontmatter.title}</h1>
    <p class="post-date-author">
      {formatDate(frontmatter.pubDate)} | <Author name={frontmatter.author} />
    </p>
    <p class="post-description">
      {frontmatter.description}
    </p>

    <figure class="post-image-container">
      <Image
        src={frontmatter.image}
        alt={frontmatter.alt}
        class="post-image-cover"
        widths={getImageWidths(frontmatter.image.width)}
        sizes={getImageSizes(frontmatter.image.width)}
        format="avif"
        data-pagefind-ignore
      />
      <figcaption class="post-image-description">{frontmatter.alt}</figcaption>
    </figure>

    <section>
      <slot />
    </section>
  </article>

  <Comments />
</BaseLayout>

<style>
  @reference "../styles/global.css";
  .post-tags {
    @apply flex flex-wrap;
  }
  .post-title {
    @apply font-bold text-4xl mt-1;
  }
  .post-date-author {
    @apply font-extralight mt-1;
  }
  .post-description {
    @apply my-4;
  }
  .post-image-container {
    @apply flex flex-col mb-4;
  }
  .post-image-cover {
    @apply self-center max-w-[100%] max-h-[36rem] shrink-0 object-contain;
  }
  .post-image-description {
    @apply self-center text-xs mt-2;
  }
  @media screen and (max-width: 720px) {
    .post-image-cover {
      @apply max-w-[100%] max-h-[36rem];
    }
  }
</style>